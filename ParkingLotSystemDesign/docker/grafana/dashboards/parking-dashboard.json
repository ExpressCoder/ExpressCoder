{
  "uid": "parking-metrics",
  "title": "Parking Lot - Metrics",
  "timezone": "browser",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "type": "graph",
      "title": "Process CPU (1m rate)",
      "targets": [ { "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "process CPU", "refId": "A" } ]
    },
    {
      "id": 2,
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "type": "graph",
      "title": "JVM Heap Used",
      "targets": [ { "expr": "jvm_memory_used_bytes{area=\"heap\"}", "legendFormat": "heap used", "refId": "A" } ]
    },
    {
      "id": 3,
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 },
      "type": "graph",
      "title": "HTTP Requests (req/s)",
      "targets": [ { "expr": "rate(http_server_requests_seconds_count[1m])", "legendFormat": "req/s", "refId": "A" } ]
    },
    {
      "id": 4,
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "type": "graph",
      "title": "Live JVM Threads",
      "targets": [ { "expr": "jvm_threads_live_threads", "legendFormat": "threads", "refId": "A" } ]
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] }
}
